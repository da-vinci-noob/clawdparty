#!/usr/bin/env bash
# bin/setup — one-time host prep for the clawdparty dev stack.
#
# Idempotent. Run once on a fresh checkout (and safe to re-run):
#   1. generate HARNESS_SHARED_SECRET into .env.local ONLY if absent (never clobber),
#   2. install the harness's own dependencies — it runs on the host, so nothing
#      installs them for it,
#   3. create the store directory the harness records into.
#
# It does NOT create databases — that happens in the rails container entrypoint,
# because no postgres container exists yet when this runs on the host.
#
# It also no longer pre-creates ~/.claude and ~/.aws. That existed so Docker would not
# auto-create them root-owned when the harness container bind-mounted them; the harness
# is a host process now, there is no such mount, and credential discovery reports an
# absent location with a remedy  rather than needing an empty directory.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
env_local="${repo_root}/.env.local"

# --- 1. HARNESS_SHARED_SECRET (generate only if absent) --------------------
generate_secret() {
  # 48 hex chars of CSPRNG randomness; openssl is present on macOS + the images.
  openssl rand -hex 24
}

ensure_secret() {
  if [[ -f "${env_local}" ]] && grep -qE '^HARNESS_SHARED_SECRET=.+' "${env_local}"; then
    echo "✓ HARNESS_SHARED_SECRET already present in .env.local — keeping it."
    return
  fi

  local secret
  secret="$(generate_secret)"

  if [[ -f "${env_local}" ]]; then
    # File exists but the secret is missing or empty: append/replace the line.
    if grep -qE '^HARNESS_SHARED_SECRET=' "${env_local}"; then
      # Replace an empty assignment in place (portable: rewrite via temp file).
      local tmp
      tmp="$(mktemp)"
      sed "s|^HARNESS_SHARED_SECRET=.*|HARNESS_SHARED_SECRET=${secret}|" "${env_local}" >"${tmp}"
      mv "${tmp}" "${env_local}"
    else
      printf '\nHARNESS_SHARED_SECRET=%s\n' "${secret}" >>"${env_local}"
    fi
  else
    printf 'HARNESS_SHARED_SECRET=%s\n' "${secret}" >"${env_local}"
  fi
  echo "✓ Generated HARNESS_SHARED_SECRET into .env.local"
}

# --- 2. Harness dependencies (it runs on the host; nothing else installs them) ---
ensure_harness_deps() {
  if [[ -d "${repo_root}/harness/node_modules/tsx" ]]; then
    echo "✓ harness dependencies present"
    return
  fi
  echo "→ installing harness dependencies (host process; no container does this)"
  (cd "${repo_root}/harness" && { npm ci || npm install; }) >/dev/null
  echo "✓ harness dependencies installed"
}

# --- 3. Store directory  -----------------
ensure_store_dir() {
  local dir="${HARNESS_STORE_DIR:-${HOME}/.local/state/clawdparty/sessions}"
  mkdir -p "${dir}"
  echo "✓ store directory ${dir}"
}

ensure_secret
ensure_harness_deps
ensure_store_dir

echo
echo "Setup complete. Next: bin/start (brings up the containers AND the host harness)"
