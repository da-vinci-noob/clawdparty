# clawdparty environment template.
#
# Copy nothing by hand: run `bin/setup`, which generates HARNESS_SHARED_SECRET
# into the git-ignored `.env.local` (the file Compose actually loads). This file
# documents every slot and its default. Values here are SAFE DEFAULTS — no
# secrets. The real secret lives only in `.env.local`.

# --- Harness shared secret -------------------------------------------------
# Bearer secret shared by Rails and the harness. Authenticates BOTH directions:
# the harness's POST /internal/events + heartbeat into Rails, AND every inbound
# harness control route ( — the harness listens on loopback, which every
# other process on the host can also reach, so placement is not the access
# control). Generated by `bin/setup` into `.env.local`. Leave blank here.
# The harness REFUSES TO START if this is empty.
HARNESS_SHARED_SECRET=

# --- Service addressing ----------------------------------------------------
# rails -> harness. The harness is a HOST process, reached across the docker
# bridge. On Docker Desktop this resolves to a harness bound to 127.0.0.1.
HARNESS_URL=http://host.docker.internal:8787
# harness -> rails callback direction (POST /internal/events + heartbeat).
# DISTINCT from HARNESS_URL — do not conflate the two directions. `localhost`
# because the harness runs on the host and rails publishes 3000 to it.
RAILS_INTERNAL_URL=http://localhost:3000

# --- Harness bind interface -------------------------------------------------
# LOOPBACK ONLY. `bin/harness` refuses 0.0.0.0 outright — the LAN surface
# is rails:3000 and nothing else.
#
# LINUX ONLY: the docker bridge does not proxy host loopback there, so a
# 127.0.0.1-bound harness is unreachable from the containers. Bind the bridge
# gateway instead (commonly 172.17.0.1 — check `ip addr show docker0`). That is
# still not the LAN.
# HARNESS_BIND_HOST=127.0.0.1

# --- Optional bash sandbox (macOS) -----------------------------------------
# OFF by default. Set to 1 to wrap model-directed `bash` in `sandbox-exec` using
# harness/sandbox/bash.sb.
#
# DEFENSE IN DEPTH, NOT THE BOUNDARY. The containment boundary is the `tool:before`
# extension point; if a command must not run, refuse it there. This is a weaker
# second layer: the profile is a DENY-LIST (anything unnamed is permitted) and
# `sandbox-exec` is deprecated by Apple, though present and working on macOS 26.
#
# It FAILS OPEN — on Linux, or without sandbox-exec/the profile, the command runs
# unsandboxed with a warning rather than being refused. A layer that can silently be
# absent cannot be the boundary, which is precisely why it is not treated as one.
#
# What it blocks: WRITES to credential dirs (~/.ssh, ~/.aws, ~/.claude, ~/.codex,
# ~/.gnupg, gh/op config), the harness store, git identity, and persistence points
# (shell rc files, LaunchAgents). Reads stay allowed — ssh must read a private key to
# push, and credential discovery reads those paths by design.
# HARNESS_BASH_SANDBOX=0

# --- Harness store ----------------------------------------------------------
# Where the per-session SQLite record lives. Deliberately OUTSIDE any project
# tree: the record is the harness's, not the repo's, and a store under a worktree
# would be committed by an approve, reverted by a reject, or deleted with the
# worktree. Leave unset to use the default below.
# HARNESS_STORE_DIR=~/.local/state/clawdparty/sessions

# --- Provider selection -----------------------------------------------------
# Which adapter a run uses when the client does not name one. The harness never
# MINTS a credential — it discovers the login you already have and records WHICH
# source won, never the value.
#   anthropic-direct   first-party API key or auth token
#   anthropic-oauth    subscription / enterprise SSO (Bearer + oauth beta header)
#   anthropic-bedrock  Bedrock via the Mantle client; AWS_REGION is REQUIRED
#   codex              reads ~/.codex/auth.json; auth_mode picks its own path
# HARNESS_DEFAULT_PROVIDER=anthropic-direct
#
# THE TRAP worth knowing: an EMPTY `ANTHROPIC_API_KEY=""` still wins its
# precedence slot and authenticates with nothing. Discovery reports it as
# selected-and-invalid rather than falling through, so `unset` it — do not blank it.

# --- Target repository -----------------------------------------------------
# ABSOLUTE host path to the directory Claude works in — set it to the PARENT of
# your repos so the folder picker can browse across them (e.g. /Users/you/dev).
#
# The HARNESS does not need this: it runs on the host and reaches any project
# directly, which is the point of. It exists for RAILS, which runs the git
# operations (worktree create, diff, approve-commit, reject-revert) in a container
# and is still mounted at the IDENTICAL in-container path. Identical paths stay
# load-bearing for that reason: git worktree metadata stores ABSOLUTE paths, so a
# worktree the host harness wrote is only openable by Rails when the two match.
# Must be absolute (a relative path cannot be an identical mount target).
TARGET_REPO_PATH=/repo

# --- Browse roots (the folder picker) --------------------------------------
# Colon-separated ABSOLUTE host paths the picker may browse from. Defaults to
# TARGET_REPO_PATH, so a single-tree setup needs nothing here. Set it when your
# repos live under more than one directory  — e.g.
#   CLAWD_BROWSE_ROOTS=/Users/you/dev:/Users/you/work
#
# Adding a root does NOT make it worktree-capable: Rails still creates review
# worktrees only under TARGET_REPO_PATH, because that path must be identical on the
# host and inside the rails container. A root nested inside another is dropped (the
# outer one already reaches it), and a root that does not exist is skipped rather
# than breaking the picker for the rest.
# CLAWD_BROWSE_ROOTS=

# --- PostgreSQL ------------------------------------------------------------
# Trust auth on the private compose network (the trusted-LAN perimeter is the
# security boundary). No password under trust auth.
POSTGRES_HOST_AUTH_METHOD=trust
POSTGRES_USER=postgres
POSTGRES_DB=postgres
# rails/jobs connection coordinates pointing at the `postgres` service.
DATABASE_HOST=postgres
DATABASE_USER=postgres

# --- Environment selectors -------------------------------------------------
RAILS_ENV=development
NODE_ENV=development

# --- Vite (dev) ------------------------------------------------------------
# Polling so HMR detects host edits over the macOS :delegated bind mount.
VITE_USE_POLLING=true

# --- Claude / AWS auth (inherited from the host, never owned) ---------------
# The harness inherits the HOST developer's EXISTING login — API key,
# subscription/enterprise OAuth, or Bedrock. The app owns NO credential.
#
# Running on the host removes the two mount caveats this section used to carry.
# There is no `~/.claude` / `~/.aws` bind mount to configure, and the macOS
# KEYCHAIN is now readable directly — so `claude setup-token` +
# CLAUDE_CODE_OAUTH_TOKEN is no longer a required workaround for subscription and
# enterprise OAuth (it stays supported as an explicit override, and still wins its
# precedence slot). SSO freshness is unchanged: `aws sso login` is the developer's
# job, since nothing can refresh that token for them.
#
# Set these in your own shell profile or here; the harness reads the host env it
# was started with, so `bin/harness` inherits your login as-is.
#   ANTHROPIC_API_KEY=
#   ANTHROPIC_AUTH_TOKEN=
#   CLAUDE_CODE_OAUTH_TOKEN=        # optional override; the Keychain is read directly now
#   CLAUDE_CODE_USE_BEDROCK=
#   CLAUDE_CODE_USE_VERTEX=
#   AWS_PROFILE=
#   AWS_REGION=
#
# ANTHROPIC_MODEL is NOT a host passthrough — set it in .env.local so the SAME
# value is authoritative for BOTH rails (run payload) and the harness. On
# Bedrock use the inference-profile form, e.g.:
#   ANTHROPIC_MODEL=us.anthropic.claude-opus-4-8[1m]

# ── The SSH AGENT Claude pushes with  ───────────────────────────
#
# SET THIS unless your agent is the one a NON-interactive shell already gets.
#
# `bin/harness` inherits the environment of whatever launched it, and a
# non-interactive shell never sources `.zshrc` — which is where an agent export
# usually lives. Under launchd it is worse: an agent gets a near-empty
# environment, so there is no socket at all unless it is named here. Both paths
# read this file (`bin/harness` sources it with `set -a` before exec), so this is
# the ONE place that serves interactive and supervised alike.
#
# The failure is quiet and easy to misdiagnose. Measured on this host: the
# harness held Apple's launchd agent, which has NO identities, while the
# developer's real agent held four keys. `ssh-add -l` said "no identities" and
# `git push` said `Permission denied (publickey)` — from inside a tool call, a
# long way from the cause. `bin/harness status` now reports which agent Claude
# will get and how many keys it holds, so check that first.
#
# QUOTE IT. `bin/harness` sources this file, so an unquoted path containing a space
# is split by the shell: it tries to run the tail as a command and leaves
# SSH_AUTH_SOCK at whatever was INHERITED — silently, so it looks configured while
# still pointing at the wrong agent. 1Password's macOS path has a space in it, so
# this is the normal case, not an edge one.
#
# 1Password (the example, not a default — nothing can detect your agent):
#   SSH_AUTH_SOCK="/Users/<you>/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
# Plain ssh-agent / gpg-agent / Secretive: use whatever `echo $SSH_AUTH_SOCK`
# prints in your own interactive shell.
